# Rename this file to .env and fill in your keys
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL but strongly recommended for GitHub demo:
# Without this, GitHub allows only 60 unauthenticated requests/hour.
# Create a token at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=your_github_personal_access_token_here

# OPTIONAL for LinkedIn OAuth 2.0 / OpenID Connect:
# Create an app at https://www.linkedin.com/developers/apps
# Enable "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/linkedin/callback

SECRET_KEY=change_this_to_a_random_secret_string

FLASK_ENV=development
FLASK_DEBUG=1
