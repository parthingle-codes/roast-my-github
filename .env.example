# Rename this file to .env and fill in your keys
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL but strongly recommended for demo:
# Without this, GitHub allows only 60 unauthenticated requests/hour.
# Create a token at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=your_github_personal_access_token_here

FLASK_ENV=development
FLASK_DEBUG=1
